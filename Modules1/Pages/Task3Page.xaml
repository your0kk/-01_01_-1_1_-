<Page x:Class="Modules1.Pages.Task3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 9.3"
      Background="White"
      FontFamily="Times New Roman">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="10" Padding="25" Background="#FF9B9393"
                BorderBrush="Black" BorderThickness="1">
            <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                <TextBlock Text="Задача 9.3 - вариант 7"
                           FontSize="24" FontWeight="Bold" />

                <TextBlock Margin="0,8,0,15"
                           Text="Проверка чередования элементов массива"
                           FontSize="18" FontWeight="Bold" />

                <TextBlock Margin="0,0,0,20"
                           Text="Дан массив ненулевых целых чисел. Проверить, чередуются ли в нем четные и нечетные числа. Если чередуются, вывести 0. Если нет, вывести номер первого элемента, который нарушает чередование."
                           TextWrapping="Wrap" FontSize="16" LineHeight="22" />

                <TextBlock Text="Введите элементы массива через пробел:"
                           Margin="0,0,0,5" FontSize="16" />

                <TextBox x:Name="arrayTextBox" MinHeight="60" Padding="7"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="White" Foreground="Black"
                         BorderBrush="Black" BorderThickness="1"
                         FontFamily="Times New Roman" FontSize="16" />

                <TextBlock x:Name="validationTextBlock" MinHeight="22"
                           Margin="0,5,0,0" Foreground="Black"
                           FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />

                <Button Width="160" Height="38" Margin="0,10,0,20"
                        HorizontalAlignment="Left" Content="Выполнить"
                        Background="White" Foreground="Black"
                        BorderBrush="Black" BorderThickness="1"
                        FontFamily="Times New Roman" FontSize="16"
                        Click="CheckAlternationButton_Click" />

                <TextBlock Text="Результат:" Margin="0,0,0,5" FontSize="16" />
                <TextBox x:Name="resultTextBox" MinHeight="50" Padding="7"
                         IsReadOnly="True" TextWrapping="Wrap"
                         Background="White" Foreground="Black"
                         BorderBrush="Black" BorderThickness="1"
                         FontFamily="Times New Roman" FontSize="16" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
