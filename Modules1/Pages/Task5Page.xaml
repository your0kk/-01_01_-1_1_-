<Page x:Class="Modules1.Pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 9.5"
      Background="White"
      FontFamily="Times New Roman">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Border Margin="10" Padding="20" Background="#FF9B9393"
                BorderBrush="Black" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Задача 9.5"
                           FontSize="24" FontWeight="Bold" />

                <TextBlock Margin="0,8,0,15"
                           Text="Обработка двумерного массива"
                           FontSize="18" FontWeight="Bold" />

                <TextBlock Margin="0,0,0,15" MaxWidth="950"
                           HorizontalAlignment="Left"
                           Text="Создать двумерный массив размером N строк и M столбцов. Заполнить его случайными числами от -10 до 10. Вывести исходный массив, элементы по возрастанию и по убыванию в трех таблицах. Найти минимальный и максимальный элементы."
                           TextWrapping="Wrap" FontSize="16" LineHeight="22" />

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Количество строк N:" Margin="0,0,0,5" FontSize="16" />
                        <TextBox x:Name="rowsTextBox" Width="160" Height="34"
                                 Padding="7,4" Text="4"
                                 Background="White" Foreground="Black"
                                 BorderBrush="Black" FontFamily="Times New Roman"
                                 FontSize="16" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Количество столбцов M:" Margin="0,0,0,5" FontSize="16" />
                        <TextBox x:Name="columnsTextBox" Width="160" Height="34"
                                 Padding="7,4" Text="5"
                                 Background="White" Foreground="Black"
                                 BorderBrush="Black" FontFamily="Times New Roman"
                                 FontSize="16" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="validationTextBlock" MinHeight="22"
                           Margin="0,5,0,0" Foreground="Black"
                           FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />

                <Button Width="220" Height="38" Margin="0,8,0,15"
                        HorizontalAlignment="Left" Content="Сгенерировать и выполнить"
                        Background="White" Foreground="Black"
                        BorderBrush="Black" BorderThickness="1"
                        FontFamily="Times New Roman" FontSize="16"
                        Click="GenerateArrayButton_Click" />

                <TextBlock x:Name="resultTextBlock" MinHeight="24"
                           Margin="0,0,0,15" FontSize="17" FontWeight="Bold" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Исходный массив" Margin="0,0,0,5"
                                   HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                        <DataGrid x:Name="sourceDataGrid" MinWidth="280" MinHeight="180"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  AutoGenerateColumns="True" HeadersVisibility="Column"
                                  GridLinesVisibility="All" BorderBrush="Black"
                                  HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black"
                                  Background="White" Foreground="Black"
                                  FontFamily="Times New Roman" FontSize="15" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0">
                        <TextBlock Text="По возрастанию" Margin="0,0,0,5"
                                   HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                        <DataGrid x:Name="ascendingDataGrid" MinWidth="280" MinHeight="180"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  AutoGenerateColumns="True" HeadersVisibility="Column"
                                  GridLinesVisibility="All" BorderBrush="Black"
                                  HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black"
                                  Background="White" Foreground="Black"
                                  FontFamily="Times New Roman" FontSize="15" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="По убыванию" Margin="0,0,0,5"
                                   HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                        <DataGrid x:Name="descendingDataGrid" MinWidth="280" MinHeight="180"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  AutoGenerateColumns="True" HeadersVisibility="Column"
                                  GridLinesVisibility="All" BorderBrush="Black"
                                  HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black"
                                  Background="White" Foreground="Black"
                                  FontFamily="Times New Roman" FontSize="15" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
