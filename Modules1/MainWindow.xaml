<Window x:Class="Modules1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Times New Roman">
    <Grid Background="#FF9B9393">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="157*"/>
            <ColumnDefinition Width="943*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="Black" BorderThickness="0,0,0,1" Grid.ColumnSpan="2">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Практическая работа - вариант №7"
                           HorizontalAlignment="Center"
                           Foreground="Black"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock x:Name="pageTitleTextBlock"
                           Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           Foreground="Black"
                           FontSize="15" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,0,1" Grid.ColumnSpan="2">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="170" Height="38" Margin="5" Content="Задача 9.1"
                        Background="White" Foreground="Black" BorderBrush="Black"
                        FontFamily="Times New Roman" FontSize="16"
                        Click="Task1Button_Click" />
                <Button Width="170" Height="38" Margin="5" Content="Задача 9.2"
                        Background="White" Foreground="Black" BorderBrush="Black"
                        FontFamily="Times New Roman" FontSize="16"
                        Click="Task2Button_Click" />
                <Button Width="170" Height="38" Margin="5" Content="Задача 9.3"
                        Background="White" Foreground="Black" BorderBrush="Black"
                        FontFamily="Times New Roman" FontSize="16"
                        Click="Task3Button_Click" />
                <Button Width="170" Height="38" Margin="5" Content="Задача 9.4"
                        Background="White" Foreground="Black" BorderBrush="Black"
                        FontFamily="Times New Roman" FontSize="16"
                        Click="Task4Button_Click" />
                <Button Width="170" Height="38" Margin="5" Content="Задача 9.5"
                        Background="White" Foreground="Black" BorderBrush="Black"
                        FontFamily="Times New Roman" FontSize="16"
                        Click="Task5Button_Click" />
            </WrapPanel>
        </Border>

        <Frame x:Name="contentFrame"
               Grid.Row="2"
               Margin="15,15,15,15"
               NavigationUIVisibility="Hidden" Grid.ColumnSpan="2" />
    </Grid>
</Window>
